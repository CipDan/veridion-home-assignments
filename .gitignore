# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# env files
vat-identifier-discovery/.env*
!vat-identifier-discovery/.env.example

# Claude settings for local projects
.claude/settings.local.json

# Cached bulk data downloads (reproducible from their source URLs, large)
vat-identifier-discovery/scripts/batch3/*.gz
vat-identifier-discovery/scripts/batch3/*.zip
vat-identifier-discovery/scripts/batch3/Organization_*.csv

# Resumable-extraction checkpoint (transient run state, not source data)
vat-identifier-discovery/scripts/batch3/*_checkpoint.json

# Python bytecode cache
__pycache__/
*.pyc